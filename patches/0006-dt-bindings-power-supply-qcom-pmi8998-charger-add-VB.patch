From 655704b4bf15d08109c273a027528b281d2b07a2 Mon Sep 17 00:00:00 2001
From: northbridgetechnology <zach@northbridgetechnology.com>
Date: Tue, 18 Aug 2026 00:13:40 -0700
Subject: [PATCH 06/13] dt-bindings: power: supply: qcom,pmi8998-charger: add
 VBUS regulator

Signed-off-by: northbridgetechnology <zach@northbridgetechnology.com>
---
 .../bindings/power/supply/qcom,pmi8998-charger.yaml       | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/Documentation/devicetree/bindings/power/supply/qcom,pmi8998-charger.yaml b/Documentation/devicetree/bindings/power/supply/qcom,pmi8998-charger.yaml
index 70f5cd6eaeab..c37dbb860d2b 100644
--- a/Documentation/devicetree/bindings/power/supply/qcom,pmi8998-charger.yaml
+++ b/Documentation/devicetree/bindings/power/supply/qcom,pmi8998-charger.yaml
@@ -40,6 +40,14 @@ properties:
 
   monitored-battery: true
 
+  vbus:
+    $ref: /schemas/regulator/regulator.yaml#
+    type: object
+    description:
+      Regulator providing VBUS when the charger operates in USB host mode.
+
+    unevaluatedProperties: false
+
 required:
   - compatible
   - reg
